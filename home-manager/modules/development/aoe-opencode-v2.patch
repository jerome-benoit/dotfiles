+impl NativeExecution {
+    pub(super) fn has_materialized_opencode_fork(
+        &self,
+        parent: &str,
+        binding: Option<&ConversationBinding>,
+    ) -> bool {
+        self.agent.name == "opencode"
+            && binding.is_some_and(|binding| {
+                binding.provenance == ConversationProvenance::Observed
+                    && binding.session_id != parent
+                    && binding.execution.as_ref().is_some_and(|owner| {
+                        Instance::execution_identity_matches(owner, &self.binding)
+                    })
+            })
+    }
+
+    pub(super) fn materialize_opencode_fork(
+        &self,
+        parent: &str,
+        existing: Option<&ConversationBinding>,
+    ) -> Result<String> {
+        anyhow::ensure!(
+            crate::session::capture::is_valid_session_id(parent),
+            "invalid OpenCode fork source"
+        );
+        let child = if let Some(binding) =
+            existing.filter(|binding| self.has_materialized_opencode_fork(parent, Some(binding)))
+        {
+            binding.session_id.clone()
+        } else {
+            let endpoint = format!("/api/session/{parent}/fork");
+            let arguments = ["api", "--standalone", "POST", &endpoint, "--data", "{}"];
+            let mut command = if let Some(container) = &self.inputs.container {
+                let mut argv = vec!["/usr/bin/env".to_owned(), "-i".to_owned()];
+                for (key, value) in &self.inputs.environment {
+                    if !self.routing.iter().any(|(routed, _)| routed == key) {
+                        argv.push(format!("{key}={value}"));
+                    }
+                }
+                for (key, value) in &self.routing {
+                    if let Some(value) = value {
+                        argv.push(format!("{key}={value}"));
+                    }
+                }
+                argv.push(
+                    self.program
+                        .to_str()
+                        .context("OpenCode program is not UTF-8")?
+                        .to_owned(),
+                );
+                argv.extend(arguments.iter().map(|argument| (*argument).to_owned()));
+                container.runtime.exec(
+                    &container.id,
+                    self.inputs
+                        .cwd
+                        .to_str()
+                        .context("OpenCode cwd is not UTF-8")?,
+                    &argv,
+                )
+            } else {
+                let mut command = std::process::Command::new(&self.program);
+                command
+                    .current_dir(&self.inputs.cwd)
+                    .env_clear()
+                    .envs(&self.inputs.environment)
+                    .args(arguments);
+                for (key, value) in &self.routing {
+                    if let Some(value) = value {
+                        command.env(key, value);
+                    } else {
+                        command.env_remove(key);
+                    }
+                }
+                command
+            };
+            command.stdin(std::process::Stdio::null());
+            let output = crate::session::capture::run_with_timeout_limit(
+                command,
+                std::time::Duration::from_secs(30),
+                "OpenCode fork API",
+                1_048_576,
+            )?;
+            decode_opencode_fork(&output, parent)?
+        };
+        let database = self
+            .binding
+            .stores
+            .first()
+            .context("OpenCode database is missing")?;
+
+        anyhow::ensure!(
+            self.binding.filesystem == "host",
+            "OpenCode fork requires a local database projection"
+        );
+        let connection = rusqlite::Connection::open_with_flags(
+            database.canonicalize()?,
+            rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY
+                | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX
+                | rusqlite::OpenFlags::SQLITE_OPEN_NOFOLLOW,
+        )?;
+        connection.busy_timeout(std::time::Duration::from_millis(100))?;
+        validate_opencode_fork_lineage(&connection, parent, &child)?;
+        Ok(child)
+    }
+}
+
+fn decode_opencode_fork(output: &[u8], parent: &str) -> Result<String> {
+    let response: serde_json::Value =
+        serde_json::from_slice(output).context("OpenCode fork response is not JSON")?;
+    let data = &response["data"];
+    let child = data["id"]
+        .as_str()
+        .context("OpenCode fork response has no session ID")?;
+    anyhow::ensure!(
+        child != parent
+            && crate::session::capture::is_valid_session_id(child)
+            && data["fork"]["sessionID"].as_str() == Some(parent),
+        "OpenCode fork response does not identify a child of the requested session"
+    );
+    Ok(child.to_owned())
+}
+
+fn validate_opencode_fork_lineage(
+    connection: &rusqlite::Connection,
+    parent: &str,
+    child: &str,
+) -> Result<()> {
+    let matches: bool = connection.query_row(
+        "SELECT fork_session_id = ?2 AND workspace_id IS NULL AND directory = (SELECT directory FROM session_v2 WHERE id = ?2) FROM session_v2 WHERE id = ?1",
+        [child, parent], |row| row.get(0),
+    ).context("OpenCode fork target or its native routing schema is unavailable")?;
+    anyhow::ensure!(
+        matches,
+        "OpenCode fork target differs from its source or routes outside its namespace"
+    );
+    Ok(())
+}
