diff --git a/crates/pa-types/src/daemon/generation.rs b/crates/pa-types/src/daemon/generation.rs
new file mode 100644
index 0000000..d43417e
--- /dev/null
+++ b/crates/pa-types/src/daemon/generation.rs
@@ -0,0 +1,115 @@
+//! Admission of session clients to a Nix-managed executable generation.
+
+use std::path::Path;
+
+use anyhow::{Context, Result};
+use serde_json::Value;
+
+/// A daemon cannot serve this Nix executable generation without an explicit restart.
+#[derive(Debug, thiserror::Error)]
+#[error("{0}")]
+pub struct NixDaemonGenerationError(String);
+
+/// Verify the executable advertised by the connection that will carry session commands.
+/// Explicit management connections may inspect other generations without this check.
+///
+/// # Errors
+/// Returns an error when a Nix-managed Unix daemon's executable differs or cannot be verified.
+pub fn verify_nix_daemon_generation(
+    hello: &Value,
+    socket_path: &Path,
+    executable: Option<&Path>,
+) -> std::result::Result<(), NixDaemonGenerationError> {
+    if !cfg!(unix) || option_env!("PRIME_AGENT_NIX_MANAGED").is_none() {
+        return Ok(());
+    }
+    verify_generation(hello, socket_path, executable)
+        .map_err(|error| NixDaemonGenerationError(format!("{error:#}")))
+}
+
+fn verify_generation(hello: &Value, socket_path: &Path, executable: Option<&Path>) -> Result<()> {
+    let expected = match executable {
+        Some(executable) => executable.canonicalize(),
+        None => std::env::current_exe().and_then(std::fs::canonicalize),
+    }
+    .context("resolve the Nix-managed Prime Agent executable")?;
+    let runtime_path = hello
+        .get("runtime")
+        .and_then(|runtime| runtime.get("executablePath"))
+        .and_then(Value::as_str)
+        .filter(|path| !path.is_empty())
+        .with_context(|| {
+            format!(
+                "Cannot verify the Prime Agent daemon executable on {}; leaving the daemon running",
+                socket_path.display()
+            )
+        })?;
+    let runtime_path = Path::new(runtime_path);
+    anyhow::ensure!(
+        runtime_path.is_absolute(),
+        "Cannot verify the non-absolute Prime Agent daemon executable {} on {}; leaving the daemon running",
+        runtime_path.display(),
+        socket_path.display()
+    );
+    let actual = runtime_path.canonicalize().with_context(|| {
+        format!(
+            "Cannot resolve the Prime Agent daemon executable {} on {}; leaving the daemon running",
+            runtime_path.display(),
+            socket_path.display()
+        )
+    })?;
+    anyhow::ensure!(
+        actual == expected,
+        "The Prime Agent daemon on {} runs a different Nix executable generation (daemon: {}; requested: {}). Existing sessions were left running.\nFinish all agents and background work before running `prime-agent shutdown` (stops all agents and background services), then retry.",
+        socket_path.display(),
+        actual.display(),
+        expected.display()
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn canonical_executable_identity_not_version_controls_admission() {
+        let directory = tempfile::tempdir().unwrap();
+        let expected = directory.path().join("expected");
+        let other = directory.path().join("other");
+        std::fs::write(&expected, b"same version").unwrap();
+        std::fs::write(&other, b"same version").unwrap();
+        let socket = directory.path().join("daemon.sock");
+        let hello = |path: &Path| json!({"runtime": {"executablePath": path}});
+        assert!(verify_generation(&hello(&expected), &socket, Some(&expected)).is_ok());
+        assert!(verify_generation(&hello(&other), &socket, Some(&expected)).is_err());
+        #[cfg(unix)]
+        {
+            let alias = directory.path().join("alias");
+            std::os::unix::fs::symlink(&expected, &alias).unwrap();
+            assert!(verify_generation(&hello(&alias), &socket, Some(&expected)).is_ok());
+        }
+        std::fs::remove_file(&other).unwrap();
+        assert!(verify_generation(&hello(&other), &socket, Some(&expected)).is_err());
+    }
+
+    #[test]
+    fn unverifiable_identity_cannot_be_admitted() {
+        let executable = std::env::current_exe().unwrap();
+        for hello in [
+            json!({}),
+            json!({"runtime": {}}),
+            json!({"runtime": {"executablePath": ""}}),
+            json!({"runtime": {"executablePath": 7}}),
+            json!({"runtime": {"executablePath": "relative/prime-agent"}}),
+        ] {
+            assert!(verify_generation(
+                &hello,
+                Path::new("/fixture/daemon.sock"),
+                Some(&executable)
+            )
+            .is_err());
+        }
+    }
+}
