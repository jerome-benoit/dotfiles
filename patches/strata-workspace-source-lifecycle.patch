diff --git a/tools/packaging/cmake_cache.sh b/tools/packaging/cmake_cache.sh
new file mode 100644
index 0000000..3d4a891
--- /dev/null
+++ b/tools/packaging/cmake_cache.sh
@@ -0,0 +1,18 @@
+# Print --fresh only for incompatible CMake metadata; binaries and unrelated caches stay.
+cmake_fresh_args() (
+  cache=$2/CMakeCache.txt
+  [ -f "$cache" ] || return 0
+  source=$(CDPATH= cd -- "$1" && pwd -P) || return
+  build=$(CDPATH= cd -- "$2" && pwd -P) || return
+  if awk -v source="$source" -v build="$build" -v generator="${3:-Ninja}" '
+    /^CMAKE_(HOME_DIRECTORY|CACHEFILE_DIR|GENERATOR):/ {
+      value = substr($0, index($0, "=") + 1); sub(/\r$/, "", value)
+      if ($0 ~ /^CMAKE_HOME_DIRECTORY:/ && value != source) changed = 1
+      if ($0 ~ /^CMAKE_CACHEFILE_DIR:/ && value != build) changed = 1
+      if ($0 ~ /^CMAKE_GENERATOR:/ && value != generator) changed = 1
+    }
+    END { exit !changed }
+  ' "$cache"; then
+    printf '%s\n' --fresh
+  fi
+)
