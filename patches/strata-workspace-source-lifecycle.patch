+def workspace_fds() -> tuple:
+    """Keep the managed workspace locked if a mutating child outlives its parent."""
+    fd = os.environ.get("STRATA_WORKSPACE_LOCK_FD")
+    return (int(fd),) if fd is not None else ()
+
+
+def workspace_state():
+    """Read a managed workspace's identity without dropping its acquisition lease."""
+    import json
+    context = os.environ.get("STRATA_WORKSPACE_CONTEXT")
+    return json.loads(context)["state"] if context is not None else None
+
+
+
+
+def open_source_lease(state=None):
+    """Own one short source reader independently of service and acquisition ownership."""
+    inherited = os.environ.pop("STRATA_SOURCE_LOCK_FD", None)
+    if inherited is not None:
+        fd = int(inherited)
+        if _source_file is not None and fd == _source_file.fileno():
+            fd = os.dup(fd)
+        lock = os.fdopen(fd, "a")
+    elif _source_file is not None:
+        lock = os.fdopen(os.dup(_source_file.fileno()), "a")
+    elif state is not None:
+        import fcntl
+        from pathlib import Path
+        lock = (Path(state) / ".source-publication.lock").open("a")
+        fcntl.flock(lock, fcntl.LOCK_SH)
+    else:
+        return None
+    os.set_inheritable(lock.fileno(), False)
+    return lock
+
+
+@contextlib.contextmanager
+def source_lease(state=None):
+    lock = open_source_lease(state)
+    try:
+        yield lock
+    finally:
+        if lock is not None:
+            if os.environ.get("STRATA_SOURCE_LOCK_FD") == str(lock.fileno()):
+                os.environ.pop("STRATA_SOURCE_LOCK_FD", None)
+            lock.close()
+
+
+_source_file = None
+
+
+def source_ready():
+    """Close only this reader; other processes can share its open file description."""
+    global _source_file
+    os.environ.pop("STRATA_SOURCE_LOCK_FD", None)
+    if _source_file is not None:
+        _source_file.close()
+        _source_file = None
+
+
+def source_handoff(lease=None, *, environ=None):
+    """Pass a source reader through exec, using a private child environment when supplied."""
+    lock = lease if lease is not None else _source_file
