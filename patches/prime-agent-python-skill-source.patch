+fn selected_skill_import_code(python_skills: &[KernelPythonSkill]) -> String {
+    let mut sources = std::collections::BTreeMap::new();
+    for skill in python_skills {
+        sources.entry(&skill.import_name).or_insert_with(|| {
+            skill
+                .package_path
+                .join("src")
+                .join(&skill.import_name)
+                .to_string_lossy()
+                .into_owned()
+        });
+    }
+    let sources_json = serde_json::to_string(&sources).expect("skill paths serialize as strings");
+    format!(
+        r#"
+import importlib.abc as _prime_agent_import_abc
+import importlib.util as _prime_agent_import_util
+import sys as _prime_agent_import_sys
+
+class _PrimeAgentSelectedSkillFinder(_prime_agent_import_abc.MetaPathFinder):
+    _prime_agent_selected_skills = True
+
+    def find_spec(self, fullname, path=None, target=None):
+        directory = self.sources.get(fullname)
+        if directory is None:
+            return None
+        return _prime_agent_import_util.spec_from_file_location(
+            fullname, directory + "/__init__.py", submodule_search_locations=[directory]
+        )
+
+_prime_agent_selected_sources = {sources_json}
+_prime_agent_import_sys.meta_path[:] = [
+    finder for finder in _prime_agent_import_sys.meta_path
+    if not getattr(finder, "_prime_agent_selected_skills", False)
+]
+for _prime_agent_cached_name in list(_prime_agent_import_sys.modules):
+    if _prime_agent_cached_name.partition(".")[0] in _prime_agent_selected_sources:
+        _prime_agent_import_sys.modules.pop(_prime_agent_cached_name, None)
+_prime_agent_selected_finder = _PrimeAgentSelectedSkillFinder()
+_prime_agent_selected_finder.sources = _prime_agent_selected_sources
+_prime_agent_import_sys.meta_path.insert(0, _prime_agent_selected_finder)
+"#
+    )
+}
+
 const RLM_BOOTSTRAP_HEADER_CODE: &str =
     "import asyncio\nimport os as _prime_agent_os\n\n_prime_agent_os.environ[\"NO_COLOR\"] = \"1\"";
 
