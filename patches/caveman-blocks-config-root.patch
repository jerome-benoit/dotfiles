+func hookTree(t *testing.T, root string) map[string]string {
+	t.Helper()
+	tree := make(map[string]string)
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		var content string
+		if entry.Type()&os.ModeSymlink != 0 {
+			content, err = os.Readlink(path)
+		} else if !entry.IsDir() {
+			var data []byte
+			data, err = os.ReadFile(path)
+			content = string(data)
+		}
+		if err != nil {
+			return err
+		}
+		tree[path] = info.Mode().String() + ":" + content
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tree
+}
+
+func TestHooksOpenCodeConfigRoot(t *testing.T) {
+	for _, name := range []string{"unset", "empty", "xdg", "xdg-empty-override", "override", "override-relative-xdg"} {
+		t.Run(name, func(t *testing.T) {
+			base := t.TempDir()
+			home, xdg, override := filepath.Join(base, "home"), filepath.Join(base, "xdg"), filepath.Join(base, "selected ' $ root")
+			t.Setenv("HOME", home)
+			t.Setenv("USERPROFILE", home)
+			t.Setenv("XDG_DATA_HOME", filepath.Join(home, "data"))
+			t.Setenv("XDG_STATE_HOME", filepath.Join(home, "state"))
+			t.Setenv("XDG_CONFIG_HOME", "")
+			t.Setenv("OPENCODE_CONFIG_DIR", "")
+			t.Setenv("CAVEMAN_NIX_MANAGED", "")
+			launcher := filepath.Join(base, "launcher")
+			if err := os.WriteFile(launcher, []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("CAVEMAN_BLOCKS_NIX_WRAPPER", launcher)
+			selected := filepath.Join(home, ".config", "opencode")
+			switch name {
+			case "unset":
+				os.Unsetenv("XDG_CONFIG_HOME")
+				os.Unsetenv("OPENCODE_CONFIG_DIR")
+			case "xdg", "xdg-empty-override":
+				t.Setenv("XDG_CONFIG_HOME", xdg)
+				selected = filepath.Join(xdg, "opencode")
+				if name == "xdg" {
+					os.Unsetenv("OPENCODE_CONFIG_DIR")
+				}
+			case "override", "override-relative-xdg":
+				t.Setenv("XDG_CONFIG_HOME", xdg)
+				if name == "override-relative-xdg" {
+					t.Setenv("XDG_CONFIG_HOME", "relative-xdg")
+				}
+				t.Setenv("OPENCODE_CONFIG_DIR", override)
+				selected = override
+			}
+			config := filepath.Join(selected, "plugins", "caveman-blocks.js")
+			status := func(scoped, installed bool) {
+				t.Helper()
+				args := []string{"hooks", "status", "--json"}
+				if scoped {
+					args = append(args, "--harness", "opencode")
+				}
+				var got struct {
+					Harnesses []harnessStatus `json:"harnesses"`
+				}
+				if err := json.Unmarshal(cli(t, args...), &got); err != nil {
+					t.Fatal(err)
+				}
+				if len(got.Harnesses) != 1 {
+					t.Fatalf("status: %+v", got)
+				}
+				h := got.Harnesses[0]
+				if h.Name != "opencode" || h.Config != config || h.Installed != installed || h.Error != "" {
+					t.Fatalf("status: %+v", h)
+				}
+			}
+			before := hookTree(t, base)
+			status(true, false)
+			if !reflect.DeepEqual(before, hookTree(t, base)) {
+				t.Fatal("status created or changed files")
+			}
+			if err := os.MkdirAll(selected, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			foreign := filepath.Join(selected, "foreign.json")
+			if err := os.WriteFile(foreign, []byte("preserve"), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			status(false, false)
+			cli(t, "hooks", "install")
+			status(false, true)
+			if _, err := os.Stat(config); err != nil {
+				t.Fatal(err)
+			}
+			installed := hookTree(t, base)
+			cli(t, "hooks", "install")
+			cli(t, "hooks", "status")
+			status(false, true)
+			if !reflect.DeepEqual(installed, hookTree(t, base)) {
+				t.Fatal("repeat installation or status changed the tree")
+			}
+			cli(t, "hooks", "uninstall")
+			status(false, false)
+			if _, err := os.Lstat(config); !os.IsNotExist(err) {
+				t.Fatalf("plugin remains: %v", err)
+			}
+			if data, err := os.ReadFile(foreign); err != nil || string(data) != "preserve" {
+				t.Fatalf("foreign file changed: %q %v", data, err)
+			}
+			for _, root := range []string{filepath.Join(home, ".config", "opencode"), filepath.Join(xdg, "opencode"), override} {
+				if root != selected {
+					if _, err := os.Lstat(root); !os.IsNotExist(err) {
+						t.Fatalf("unselected root changed: %s: %v", root, err)
+					}
+				}
+			}
+		})
+	}
+}
