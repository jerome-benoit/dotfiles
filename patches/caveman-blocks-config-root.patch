+func TestHooksOpenCodeRelativeRootRefused(t *testing.T) {
+	for _, name := range []string{"override", "override-no-xdg", "xdg-unset-override", "xdg-empty-override"} {
+		t.Run(name, func(t *testing.T) {
+			base := t.TempDir()
+			t.Chdir(base)
+			t.Setenv("HOME", filepath.Join(base, "home"))
+			t.Setenv("USERPROFILE", filepath.Join(base, "home"))
+			t.Setenv("XDG_DATA_HOME", filepath.Join(base, "data"))
+			t.Setenv("XDG_STATE_HOME", filepath.Join(base, "state"))
+			t.Setenv("CAVEMAN_NIX_MANAGED", "")
+			t.Setenv("XDG_CONFIG_HOME", filepath.Join(base, "xdg"))
+			t.Setenv("OPENCODE_CONFIG_DIR", filepath.Join(base, "selected"))
+			launcher := filepath.Join(base, "launcher")
+			if err := os.WriteFile(launcher, []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("CAVEMAN_BLOCKS_NIX_WRAPPER", launcher)
+			cli(t, "hooks", "install", "--harness", "opencode")
+			if name == "override" || name == "override-no-xdg" {
+				t.Setenv("OPENCODE_CONFIG_DIR", "relative-root")
+				if name == "override-no-xdg" {
+					os.Unsetenv("XDG_CONFIG_HOME")
+				}
+			} else {
+				t.Setenv("OPENCODE_CONFIG_DIR", "")
+				if name == "xdg-unset-override" {
+					os.Unsetenv("OPENCODE_CONFIG_DIR")
+				}
+				t.Setenv("XDG_CONFIG_HOME", "relative-xdg")
+			}
+			before := hookTree(t, base)
+			for _, action := range []string{"install", "uninstall", "status"} {
+				root := newRoot()
+				args := []string{"hooks", action, "--harness", "opencode"}
+				if action == "status" {
+					args = append(args, "--json")
+				}
+				root.SetArgs(args)
+				root.SetOut(new(bytes.Buffer))
+				root.SetErr(new(bytes.Buffer))
+				if err := root.Execute(); err == nil {
+					t.Fatalf("%s accepted a relative root", action)
+				}
+				if !reflect.DeepEqual(before, hookTree(t, base)) {
+					t.Fatalf("%s changed files or the stable launcher", action)
+				}
+			}
+		})
+	}
