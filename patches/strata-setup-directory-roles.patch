+def retained_data_sources(dest, *, requested=False, move=False):
+    """Predict roots setup keeps in place; progress must not perform data_folder's moves."""
+    settings = load_settings()
+    held = []
+    for folder in data_sources(dest, settings, requested=requested):
+        if not same_folder(folder, dest) and has_data(folder) and not any(same_folder(folder, h) for h in held):
+            held.append(folder)
+    remembered = Path(settings["data_dir"]) if settings.get("data_dir") else home().parent / "Strata-data"
+    if requested and not same_folder(dest, remembered) and not move:
+        return held
+    existing = dest
+    while not existing.exists() and existing != existing.parent:
+        existing = existing.parent
+    return [folder for folder in held if not same_drive(folder, existing)]
