 import threading
 
 ENV = "STRATA_NO_ACQUIRE"
+
+def workspace_fds() -> tuple:
+    """Keep the managed workspace locked if a mutating child outlives its parent."""
+    fd = os.environ.get("STRATA_WORKSPACE_LOCK_FD")
+    return (int(fd),) if fd is not None else ()
+
+
+def release_workspace():
+    """Drop acquisition ownership and return only the state path needed by a monitor."""
+    import json
+    context = os.environ.pop("STRATA_WORKSPACE_CONTEXT", None)
+    fd = os.environ.pop("STRATA_WORKSPACE_LOCK_FD", None)
+    os.environ.pop("STRATA_WORKSPACE_HELPER", None)
+    if fd is not None:
+        # Do not LOCK_UN: a surviving mutator may share this open file description.
+        os.close(int(fd))
+    return json.loads(context)["state"] if context is not None else None
+
+
+_workspace_mutation_lock = threading.Lock()
+
+
+@contextlib.contextmanager
+def workspace_mutation(state):
+    """Own a fresh workspace lock only while a monitor updates and restarts models."""
+    if state is None:
+        yield
+        return
+    import fcntl
+    import json
+    from pathlib import Path
+    # The descriptor protocol is process-wide; two worker threads must not overwrite it.
+    if not _workspace_mutation_lock.acquire(blocking=False):
+        raise RuntimeError("workspace is busy; retry the update when acquisition finishes")
+    try:
+        with (Path(state) / ".source.lock").open("a") as lock:
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                raise RuntimeError("workspace is busy; retry the update when acquisition finishes") from None
+            os.environ["STRATA_WORKSPACE_LOCK_FD"] = str(lock.fileno())
+            os.environ["STRATA_WORKSPACE_CONTEXT"] = json.dumps({"state": str(state)})
+            try:
+                yield
+            finally:
+                # Purge before close; mutating children may still own this file description.
+                os.environ.pop("STRATA_WORKSPACE_LOCK_FD", None)
+                os.environ.pop("STRATA_WORKSPACE_HELPER", None)
+                os.environ.pop("STRATA_WORKSPACE_CONTEXT", None)
+    finally:
+        _workspace_mutation_lock.release()
+
 
 _lock = threading.Lock()
