+def engine_argument_path(raw: str, exe: str, cfg: dict) -> Path:
+    """Map only container engine arguments back to the wrapper's host mount."""
+    value = Path(raw).expanduser()
+    if Path(exe).name != "strata-sycl.sh":
+        return value
+    repo = Path(exe).resolve().parents[2]
+    mount = Path((cfg.get("env") or {}).get("STRATA_SYCL_ROOT", os.environ.get("STRATA_SYCL_ROOT"))
+                 or repo.parent).expanduser()
+    if not mount.is_absolute():
+        mount = (Path(cfg.get("cwd") or os.getcwd()) / mount).resolve()
+    if value == Path("/work"):
+        return mount
+    if value.is_relative_to("/work"):
+        return mount / value.relative_to("/work")
+    if not value.is_absolute():
+        return mount / repo.name / value
+    return value
+
