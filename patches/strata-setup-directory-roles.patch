+@contextlib.contextmanager
+def workspace_mutation(state):
+    """Own a fresh workspace lock only while a monitor updates and restarts models."""
+    if state is None:
+        yield
+        return
+    import fcntl
+    import json
+    from pathlib import Path
+    # The descriptor protocol is process-wide; two worker threads must not overwrite it.
+    if not _workspace_mutation_lock.acquire(blocking=False):
+        raise RuntimeError("workspace is busy; retry the update when acquisition finishes")
+    try:
+        with (Path(state) / ".source.lock").open("a") as lock:
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                raise RuntimeError("workspace is busy; retry the update when acquisition finishes") from None
+            os.environ["STRATA_WORKSPACE_LOCK_FD"] = str(lock.fileno())
+            os.environ["STRATA_WORKSPACE_CONTEXT"] = json.dumps({"state": str(state)})
+            try:
+                yield
+            finally:
+                # Purge before close; mutating children may still own this file description.
+                os.environ.pop("STRATA_WORKSPACE_LOCK_FD", None)
+                os.environ.pop("STRATA_WORKSPACE_HELPER", None)
+                os.environ.pop("STRATA_WORKSPACE_CONTEXT", None)
+    finally:
+        _workspace_mutation_lock.release()
