+def engine_binary(exe: str, cfg: dict | None = None) -> str:
+    """Resolve the engine behind the Intel container launcher without importing the server."""
+    p = Path(exe)
+    if p.name == "strata-sycl.sh":
+        rel = ((cfg or {}).get("env") or {}).get("STRATA_SYCL_BIN", os.environ.get("STRATA_SYCL_BIN")) \
