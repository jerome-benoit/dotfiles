+def destination_budgets(needs):
+    """Group known remaining GB by the filesystem of each destination's nearest existing parent."""
+    groups = {}
+    for destination, gb in needs:
+        if gb <= 0:
+            continue
+        parent = Path(destination).parent
+        while not parent.exists():
+            parent = parent.parent
+        device = parent.stat().st_dev
+        previous = groups.get(device, (parent, 0.0))
+        groups[device] = (previous[0], previous[1] + gb)
+    return list(groups.values())
+
+
+def ready_disk_problem(model, models_dir, data_dir=None, vision_file=None, checkpoint_dir=None):
+    """Check disk space for remaining downloads and estimated preparation."""
+    needs = []
+    for f in ready_needed(model, models_dir, data_dir):
+        dst = ready_where(models_dir, f, data_dir, checkpoint_dir)
+        if not ready_verified(dst, f[5]):
+            present = sum(p.stat().st_size for p in (dst, dst.with_name(dst.name + ".part")) if p.is_file())
+            needs.append((dst, max(0, f[4] - present) / 1e9))
+    if vision_file is not None and not vision_file.exists():
+        needs.append((vision_file, 1.0))                 # same vision allowance as the ordinary setup path
+    if MODELS[model].get("prepare") and not prepared_done(model, models_dir, data_dir):
+        paths = ready_paths(model, models_dir, data_dir)
+        if len(destination_budgets([(paths["dense"], 1), (paths["pack"] / "index.txt", 1)])) == 1:
+            needs.append((paths["dense"], MODELS[model]["prepare_gb"]))  # aggregate estimate applies once on one filesystem
+        else:
+            if not (paths["pack"].parent / "pack.done").is_file():
+                needs.append((paths["pack"] / "index.txt", MODELS[model]["arena_gb"]))  # at least the expert arena
+            warn(f"preparation writes about {MODELS[model]['prepare_gb']:.0f} GB across {models_dir} and "
+                 f"{Path(data_dir) / 'models' if data_dir is not None else models_dir}; the remaining split is unknown. "
+                 "Disk checks cover pinned downloads and the expert arena, not all future preparation outputs")
+    for parent, gb in destination_budgets(needs):
+        free = free_gb(parent)
+        if free < gb:
+            return (f"not enough free disk space in {parent}: need ~{gb:.0f} GB, {free:.0f} GB free",
+                    "use --data-dir or --models-dir on a bigger drive for the files stored there")
+    return None
 
 
