+  }
+  if (/^[+-]?\d[\d_]*(?::[0-5]?\d)+\.[\d_]*$/.test(plain)) return /[1-9]/.test(plain);
+  if (/^(?:[+-]?\d[\d_]*(?:\.[\d_]*(?:[eE][+-]?\d+)?|[eE][+-]?\d+)|\.[\d_]+(?:[eE][+-]\d+)?)$/.test(plain)) {
