+function hermesYamlLeaf(lines: string[], entry: HermesYamlEntry | undefined): string | boolean {
+  if (!entry) throw new Error("Hermes YAML owned field is missing");
+  let end = entry.end;
+  while (end > entry.start + 1 && !hermesYamlContent(lines[end - 1]!)) end--;
+  let value = entry.value;
+  for (let i = entry.start + 1; i < end; i++) {
+    const line = lines[i]!;
+    const quoted = /^["']/.test(value.trimStart());
+    const closedQuote = /^(?:"(?:[^"\\]|\\.)*"|'(?:[^']|'')*')\s*(?:#.*)?$/.test(value.trim());
+    if (closedQuote || (!quoted && /(?:^|\s)#/.test(value))) {
