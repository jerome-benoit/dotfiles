+      } else if (char === ",") throw new Error("Hermes MCP flow map has an empty field");
+      if (char === "}") {
+        if (!/^[ \t\n]*(?:#[^\n]*(?:\n|$)[ \t\n]*)*$/.test(source.slice(i + 1))) {
+          throw new Error("Hermes MCP flow map continues after its end");
+        }
+        return fields;
+      }
+      token = "";
+      tokenStart = true;
+      continue;
+    }
+    if (tokenStart && (char === '"' || char === "'")) quote = char;
+    if (tokenStart && (char === "[" || char === "{")) depth++;
+    if (depth && (char === "]" || char === "}")) depth--;
+    if (!/[ \t\n]/.test(char)) tokenStart = /[:[\]{,]/.test(char);
+    token += char;
+  }
