+  if (/^["'*!&|>]/.test(plain)) return hermesYamlScalar(raw);
+  if (/^[yn]$/i.test(plain)) return plain.toLowerCase() === "y";
+  if (/^[+-]?\.(?:inf|Inf|INF)$|^\.(?:nan|NaN|NAN)$/.test(plain)) return true;
+  if (/^[+-]?(?:0|[1-9][\d_]*(?::[0-5]?\d)*|0[0-7_]+|0b[01_]+|0x[\da-fA-F_]+)$/.test(plain)) {
