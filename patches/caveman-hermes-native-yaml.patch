+        const key = hermesYamlTrim(pair[1]!);
+        const name = /^["']/.test(key) || pair[2] === undefined ? hermesYamlScalar(key) : /^(?:[ \t\n[\]{},]|$)/.test(pair[2]) ? key : raw;
