+          return JSON.stringify(String.fromCodePoint(parseInt(escape.slice(1), 16))).slice(1, -1);
+        }
+        return escapes[escape] ?? full;
+      }));
+    }
+  } else if (raw.startsWith("'")) {
+    const match = raw.match(/^'((?:[^']|'')*)'\s*(?:#.*)?$/);
+    if (match) return match[1]!.replace(/''/g, "'");
