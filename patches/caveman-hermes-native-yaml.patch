+function hermesYamlMap(lines: string[], parent?: HermesYamlEntry): Map<string, HermesYamlEntry> {
+  if (parent && !/^\s*(?:#.*)?$/.test(parent.value)) throw new Error("Hermes YAML mapping is not a plain block");
+  const start = parent ? parent.start + 1 : yamlBodyStart(lines);
+  const end = parent?.end ?? lines.length;
+  const entries = new Map<string, HermesYamlEntry>();
+  let indent = parent ? -1 : 0;
+  let previous: HermesYamlEntry | undefined;
+  for (let i = start; i < end; i++) {
+    const line = lines[i]!;
+    if (!hermesYamlContent(line)) continue;
+    if (/^\s*\t/.test(line)) throw new Error("Hermes YAML uses ambiguous indentation");
+    const width = line.match(/^ */)![0].length;
+    if (indent < 0) {
+      if (width <= parent!.indent) throw new Error("Hermes YAML child mapping has ambiguous indentation");
+      indent = width;
+    }
+    if (width > indent) continue;
+    // PyYAML emits indentless sequences beneath a mapping key.
+    if (width === indent && /^ *- /.test(line) && previous && /^\s*(?:#.*)?$/.test(previous.value)) continue;
+    const match = line.match(/^( *)("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[A-Za-z0-9_.-]+):(?:\s+(.*)|\s*)$/);
+    if (width !== indent || !match) throw new Error("Hermes YAML mapping has an unsupported or ambiguous shape");
+    const key = match[2]!.startsWith('"') || match[2]!.startsWith("'") ? hermesYamlScalar(match[2]!) : match[2]!;
+    if (typeof key !== "string" || entries.has(key)) throw new Error("Hermes YAML mapping has duplicated keys");
+    if (previous) previous.end = i;
+    previous = { start: i, end, indent, value: match[3] ?? "" };
+    entries.set(key, previous);
+  }
+  return entries;
