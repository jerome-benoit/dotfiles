+  const block = owned.mcp_block;
+  const expectedLines = yamlLines(/^mcp_servers:/m.test(block) ? block : `mcp_servers:\n${block}`);
+  const expectedRoot = hermesYamlMap(expectedLines);
+  const expectedServers = hermesYamlMap(expectedLines, hermesYamlRequired(expectedRoot, "mcp_servers"));
+  const expected = hermesYamlMap(expectedLines, hermesYamlRequired(expectedServers, "caveman-native"));
+  const actual = hermesYamlMap(lines, server);
