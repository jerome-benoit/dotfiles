+    if (/^(?:false|False|FALSE)$/.test(plain)) return false;
+    if (plain && !/^[-?:,[\]{}#&*!|>'"%@`]/.test(plain) && !/:\s/.test(plain)
+      && !/^(?:null|~|yes|no|on|off)$/i.test(plain) && !/^[-+]?(?:\d|\.\d)/.test(plain)) return plain;
+  }
+  throw new Error("Hermes YAML scalar is ambiguous; refusing unsafe native merge");
