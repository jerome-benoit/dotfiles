+// Read flow fields for status only; ownership still requires block mappings.
+function hermesMcpFlowFields(source: string): Map<string, string> {
+  const fields = new Map<string, string>();
+  let token = "";
+  let quote: string | undefined;
+  let depth = 0;
+  let tokenStart = true;
+  for (let i = source.indexOf("{") + 1; i < source.length; i++) {
+    const char = source[i]!;
+    if (quote) {
+      token += char;
+      if ((char === "\\" && quote === '"') || (char === "'" && quote === "'" && source[i + 1] === "'")) {
+        token += source[++i] ?? "";
+      } else if (char === quote) quote = undefined;
+      continue;
+    }
+    if (hermesYamlCommentStart(source, i, tokenStart)) {
+      while (i + 1 < source.length && source[i + 1] !== "\n") i++;
+      continue;
+    }
+    if (depth === 0 && (char === "," || char === "}")) {
+      const raw = token.replace(/^[ \t\n]+|[ \t\n]+$/g, "");
+      if (raw) {
+        const pair = raw.match(/^("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^:"'\s][^:]*?)[ \t\n]*(?::([\s\S]*))?$/);
