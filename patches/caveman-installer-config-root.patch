# Workaround: OpenCode overrides its complete config root.
# Remove when upstream installer honors OPENCODE_CONFIG_DIR.
--- a/installer/install.js
+++ b/installer/install.js
@@ -1544,6 +1544,10 @@
 }
 
 function opencodeConfigDir() {
+  if (process.env.OPENCODE_CONFIG_DIR) {
+    if (!path.isAbsolute(process.env.OPENCODE_CONFIG_DIR)) throw new Error('OpenCode config root must be absolute');
+    return process.env.OPENCODE_CONFIG_DIR;
+  }
   // opencode uses ~/.config/opencode on every platform (on Windows that's
   // %USERPROFILE%\.config\opencode via os.homedir()), NOT %APPDATA% (#376).
   if (process.env.XDG_CONFIG_HOME) return path.join(process.env.XDG_CONFIG_HOME, 'opencode');
--- a/src/plugins/opencode/plugin.js
+++ b/src/plugins/opencode/plugin.js
@@ -129,11 +129,15 @@
 }
 const { parseModeChange, INDEPENDENT_MODES } = loadParse();
 
-// opencode resolves its config dir from $XDG_CONFIG_HOME, else ~/.config/opencode
+// opencode resolves OPENCODE_CONFIG_DIR first, then XDG_CONFIG_HOME/opencode or ~/.config/opencode
 // on every platform — including Windows, where it uses %USERPROFILE%\.config\opencode
 // (NOT %APPDATA%). os.homedir() is %USERPROFILE% on win32, so the default branch
 // is already correct cross-platform.
 function opencodeConfigDir() {
+  if (process.env.OPENCODE_CONFIG_DIR) {
+    if (!path.isAbsolute(process.env.OPENCODE_CONFIG_DIR)) throw new Error('OpenCode config root must be absolute');
+    return process.env.OPENCODE_CONFIG_DIR;
+  }
   if (process.env.XDG_CONFIG_HOME) {
     return path.join(process.env.XDG_CONFIG_HOME, 'opencode');
   }
