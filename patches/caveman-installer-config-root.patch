# base: JuliusBrussee/caveman b4ee71d557d96e3cbc14f88fa6e953a1362865f5
# prerequisites: caveman-nix-installer-paths.patch
# intent: Preserve root precedence and reject relative OPENCODE_CONFIG_DIR overrides.
#   Preserve nonempty override bytes and the upstream XDG_CONFIG_HOME fallback.
diff --git a/installer/install.js b/installer/install.js
--- a/installer/install.js
+++ b/installer/install.js
@@ -1591,7 +1591,10 @@
   // Windows that's %USERPROFILE%\.config\opencode via os.homedir()), NOT
   // %APPDATA% (#376). Same order as the CLI and the mode plugin.
   const selected = process.env.OPENCODE_CONFIG_DIR || '';
-  if (selected.trim()) return path.resolve(selected);
+  if (selected) {
+    if (!path.isAbsolute(selected)) throw new Error('OpenCode config root must be absolute');
+    return selected;
+  }
   if (process.env.XDG_CONFIG_HOME) return path.join(process.env.XDG_CONFIG_HOME, 'opencode');
   return path.join(os.homedir(), '.config', 'opencode');
 }
diff --git a/src/plugins/opencode/plugin.js b/src/plugins/opencode/plugin.js
--- a/src/plugins/opencode/plugin.js
+++ b/src/plugins/opencode/plugin.js
@@ -137,8 +137,9 @@
 // order; a flag written under a root the host does not read is invisible to it.
 function opencodeConfigDir() {
   const selected = process.env.OPENCODE_CONFIG_DIR || '';
-  if (selected.trim()) {
-    return path.resolve(selected);
+  if (selected) {
+    if (!path.isAbsolute(selected)) throw new Error('OpenCode config root must be absolute');
+    return selected;
   }
   if (process.env.XDG_CONFIG_HOME) {
     return path.join(process.env.XDG_CONFIG_HOME, 'opencode');
