diff --git a/strata_control/cfg_paths.py b/strata_control/cfg_paths.py
--- a/strata_control/cfg_paths.py
+++ b/strata_control/cfg_paths.py
@@ -29,6 +29,35 @@
 _VERSION = re.compile(r"^\d+(?:\.\d+)+")
 SKIP_KEYS = ("log",)                      # paths the engine writes, not reads
 SKIP_FLAGS = ("--expert-profile-save",)
+
+
+def engine_binary(exe: str, cfg: dict | None = None) -> str:
+    """Resolve the engine behind the Intel container launcher without importing the server."""
+    p = Path(exe)
+    if p.name == "strata-sycl.sh":
+        rel = ((cfg or {}).get("env") or {}).get("STRATA_SYCL_BIN", os.environ.get("STRATA_SYCL_BIN")) \
+            or "build-sycl-aot/strata"
+        return str(engine_argument_path(rel, exe, cfg or {}))
+    return exe
+
+
+def engine_argument_path(raw: str, exe: str, cfg: dict) -> Path:
+    """Map only container engine arguments back to the wrapper's host mount."""
+    value = Path(raw).expanduser()
+    if Path(exe).name != "strata-sycl.sh":
+        return value
+    repo = Path(exe).resolve().parents[2]
+    mount = Path((cfg.get("env") or {}).get("STRATA_SYCL_ROOT", os.environ.get("STRATA_SYCL_ROOT"))
+                 or repo.parent).expanduser()
+    if not mount.is_absolute():
+        mount = (Path(cfg.get("cwd") or os.getcwd()) / mount).resolve()
+    if value == Path("/work"):
+        return mount
+    if value.is_relative_to("/work"):
+        return mount / value.relative_to("/work")
+    if not value.is_absolute():
+        return mount / repo.name / value
+    return value
 
 
