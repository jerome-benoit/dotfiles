+def resume_bytes(destination, total=None, *, url=None, available=None):
+    """Read reusable download evidence without changing files or crediting sparse length."""
+    destination = Path(destination)
+    part = destination.with_name(destination.name + ".part")
+    side = part.with_name(part.name + ".chunks")
+    source = part.with_name(part.name + ".src")
+    if available is not None:
+        part, side, source = map(available, (part, side, source))
+    if part is None or not part.is_file():
+        return 0
+    has_chunks = side is not None and side.is_file()
+    part_info = part.stat()
+    size = part_info.st_size
+    if not has_chunks and getattr(part_info, "st_blocks", None) is not None and part_info.st_blocks * 512 < size:
+        return 0  # No chunk receipt proves which sparse ranges are reusable.
+    if url is not None and source is not None and source.is_file():
+        try:
+            saved = json.loads(source.read_text())
+        except (OSError, ValueError):
+            return 0
+        if not isinstance(saved, dict) or saved.get("url") != url:
+            return 0
+    if total is None:
+        if not has_chunks:
+            return size
+        try:
+            total = json.loads(side.read_text())["total"]
+        except (OSError, ValueError, TypeError, KeyError):
+            return 0
+        if not isinstance(total, int) or total <= 0:
+            return 0
+    if total >= DL_MIN_PARALLEL and dl_connections() > 1:
+        if not has_chunks:
+            if size > total:
+                return 0
+            return total if size == total else (size // DL_CHUNK) * DL_CHUNK
+        return sum(min(DL_CHUNK, total - i * DL_CHUNK)
+                   for i in _load_pieces(part, total, clean=False, side=side) if i >= 0)
+    if has_chunks:
+        return min(_prefix_bytes(_load_pieces(part, total, clean=False, side=side), total), size)
+    return size if size <= total else 0
+
