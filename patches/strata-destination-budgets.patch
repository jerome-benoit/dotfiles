+def resume_bytes(destination, total=None, *, url=None):
+    """Read native reusable download evidence without changing files or mistaking sparse length for chunks."""
+    part = Path(destination).with_name(Path(destination).name + ".part")
+    side = part.with_name(part.name + ".chunks")
+    if not part.is_file():
+        return 0
+    if url is not None:
+        source = part.with_name(part.name + ".src")
+        if source.is_file():
+            try:
+                saved = json.loads(source.read_text())
+            except (OSError, ValueError):
+                return 0
+            if not isinstance(saved, dict) or saved.get("url") != url:
+                return 0
+    if total is None:
+        if not side.is_file():
+            return part.stat().st_size                 # native single-stream resume, no chunk list
+        try:
+            total = json.loads(side.read_text())["total"]
+        except (OSError, ValueError, TypeError, KeyError):
+            return 0
+        if not isinstance(total, int) or total <= 0:
+            return 0
+    if side.is_file() or total >= DL_MIN_PARALLEL and dl_connections() > 1:
+        return sum(min(DL_CHUNK, total - i * DL_CHUNK)
+                   for i in _load_pieces(part, total, clean=False) if i >= 0)
+    size = part.stat().st_size
+    return size if size <= total else 0
+
