+        path = find_in(roots, f"models/{name}") or path
+    size, sha = fam.get("mmproj_sha256") or ISTA_FILES.get(name) or (None, None)
+    return resolve_reader(name, path, models_dir, roots, gguf_dir, size, sha, start=start)
