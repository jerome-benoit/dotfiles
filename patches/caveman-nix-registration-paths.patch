+// Nix runtime binaries belong to a generation; registrations belong to a lexical
+// profile prefix. Never resolve that prefix through its current store symlink.
+function registrationPath(...parts: string[]): string | undefined {
+  if (process.env.CAVEMAN_NIX_MANAGED !== "1")
+    return undefined;
+  const input = process.env.CAVEMAN_REGISTRATION_ROOT;
+  const root = input && isAbsolute(input) ? normalize(input) : undefined;
+  if (!root || /^\/nix\/store(?:\/|$)/.test(root)) {
+    throw new Error("Caveman is managed by Nix; persistent agent registration requires CAVEMAN_REGISTRATION_ROOT to name an absolute stable profile prefix outside /nix/store. Run through the profile's bin/caveman or set CAVEMAN_REGISTRATION_ROOT explicitly; do not resolve the profile symlink.");
+  }
+  return join(root, ...parts);
+}
+// Planning must not fail when the managed install has no usable profile prefix.
+function registrationBinOrUndefined(name: string): string | undefined {
+  try {
+    return registrationPath("bin", name);
+  }
+  catch {
+    return undefined;
+  }
+}
+// Classify the decoded MCP executable, not its arguments, route or restore data.
+// Lexical profile paths can contain spaces and /nix/store/ below their root.
+function registrationRefersToStorePath(kind: string, owned: Record<string, unknown> | undefined): boolean {
+  let command: unknown;
+  if (kind === "claude-mcp" || kind === "opencode-config" || kind === "gemini-settings") {
+    const mcp = owned?.installed_mcp;
+    if (mcp && typeof mcp === "object") {
+      command = (mcp as Record<string, unknown>).command;
+      if (kind === "opencode-config")
+        command = Array.isArray(command) ? command[0] : undefined;
+    }
+  } else {
+    let encoded: string | undefined;
+    if (kind === "codex-config" && typeof owned?.tables_block === "string") {
+      encoded = codexTomlLines(owned.tables_block)
+        .find((line) => line.section === "mcp_servers.caveman" && line.key === "command")?.value;
+    } else if (kind === "hermes-config" && typeof owned?.mcp_block === "string") {
+      const prefix = "    command: ";
+      encoded = yamlLines(owned.mcp_block).find((line) => line.startsWith(prefix))?.slice(prefix.length);
+    }
+    if (encoded !== undefined) {
+      try {
+        command = JSON.parse(encoded);
+      } catch {
+        return false;
+      }
+    }
+  }
+  return typeof command === "string" && command.startsWith("/nix/store/");
+}
