+/// Refuse imperative self-update for builds managed by Nix.
+#[must_use]
+pub const fn nix_self_update_refusal() -> Option<&'static str> {
+    if option_env!("PRIME_AGENT_NIX_MANAGED").is_some() {
+        Some(
+            "This Prime Agent build is managed by Nix. Update the pinned package and rebuild your Nix/Home Manager configuration; self-update is disabled.",
+        )
+    } else {
+        None
+    }
+}
