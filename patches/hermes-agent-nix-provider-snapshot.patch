# base: hermes-agent 33522e6deeb77d3bd8c5c4222d0681f53974cc30
# prerequisites: none
# intent: make only owned copies of read-only provider directories writable before publication and cleanup.
# upstream: https://github.com/NousResearch/hermes-agent/issues/156560 tracks snapshot publication and cleanup failures.
# removal: remove when Hermes discovers providers from read-only sources and cleans up on exit or partial copy failure without mutating the source or external link targets.
diff --git a/providers/plugin_reload.py b/providers/plugin_reload.py
--- a/providers/plugin_reload.py
+++ b/providers/plugin_reload.py
@@ -155,8 +155,15 @@ def _snapshot(plugin_dir: Path, module_name: str) -> Path:
     target.parent.mkdir(parents=True, exist_ok=True)
     private = Path(tempfile.mkdtemp(prefix=".copy-", dir=target.parent))
     try:
-        shutil.copytree(plugin_dir, private / plugin_dir.name, ignore=_SNAPSHOT_IGNORE)
-        os.rename(private / plugin_dir.name, target)
+        copied = private / plugin_dir.name
+        try:
+            shutil.copytree(plugin_dir, copied, ignore=_SNAPSHOT_IGNORE)
+        finally:
+            for directory, _, _ in os.walk(copied):
+                mode = os.stat(directory).st_mode
+                if not mode & 0o200:
+                    os.chmod(directory, mode | 0o200)
+        os.rename(copied, target)
     except OSError:
         if not target.is_dir():  # another scan publishing the same copy first is fine
             raise
