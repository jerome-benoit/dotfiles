     }
 }
 
-/// `AF_UNIX` `sun_path` capacity: 108 bytes including the terminating NUL.
-#[cfg(unix)]
+/// `AF_UNIX` `sun_path` capacity minus the terminating NUL: 107 usable bytes
+/// on Linux (108-byte `sun_path`), 103 on macOS and the BSDs (104-byte
+/// `sun_path`).
+#[cfg(all(unix, target_os = "linux"))]
 const MAX_SUN_PATH: usize = 107;
+#[cfg(all(unix, not(target_os = "linux")))]
+const MAX_SUN_PATH: usize = 103;
 
