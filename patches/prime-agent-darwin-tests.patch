# base: v0.10.0
# intent: platform-correct AF_UNIX sun_path (104 on macOS/BSD vs 108 on Linux),
#   gate the Linux-only /proc re-anchor test, and skip the Darwin ps ground-truth
#   test when /bin/ps is unavailable (restricted/sandboxed macOS builds).
diff --git a/crates/pa-types/src/platform/process.rs b/crates/pa-types/src/platform/process.rs
index 83babd0..a3c2aae 100644
--- a/crates/pa-types/src/platform/process.rs
+++ b/crates/pa-types/src/platform/process.rs
@@ -678,6 +678,12 @@ mod darwin_process_record_tests {
             );
             return;
         }
+        // The ground truth shells out to `/bin/ps`; the macOS Nix build
+        // sandbox blocks process enumeration (`ps` yields nothing), so skip
+        // the comparison when the ground truth cannot be read.
+        if ps_lstart_identity(std::process::id()).is_none() {
+            return;
+        }
         // Detached stdio: a sleep leaked by an assert failure cannot hold
         // the parent's output pipes open.
         let mut child = Command::new("/bin/sleep")
