+test("Hermes codemode refuses flow MCP edits and leaves the real config untouched", (t) => {
+  const root = mkdtempSync(join(tmpdir(), "caveman-hermes-cm-flow-"));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  const sourceHome = join(root, "real");
+  const outDir = join(root, "ephemeral");
+  mkdirSync(sourceHome);
+  mkdirSync(outDir);
+  const sourceConfig = join(sourceHome, "config.yaml");
+  const editedConfig = join(outDir, "config.yaml");
+  const build = () => buildHermesEphemeralCodemodeHome(sourceHome, outDir, { command: "cm", args: [] });
+  const originalFlow = 'model: original\n"mcp_servers": {docs: {command: docs-mcp}}\n';
+  const originalBlock = "model: original\nmcp_servers:\n  docs:\n    command: docs-mcp\n";
+  const diagnostic = t.mock.method(process.stderr, "write", () => true);
+
+  writeFileSync(sourceConfig, originalBlock);
+  build();
+  const editedBlock = readFileSync(editedConfig, "utf8").replace("model: original", "model: edited");
+  writeFileSync(editedConfig, editedBlock);
+  writeFileSync(sourceConfig, originalFlow);
+  syncBackHermesEphemeralHome(outDir, sourceHome);
+  assert.equal(readFileSync(sourceConfig, "utf8"), originalFlow);
+  assert.match(diagnostic.mock.calls.at(-1).arguments[0], /config\.yaml was not synced.*unsupported Hermes/);
+
+  writeFileSync(sourceConfig, originalBlock);
+  writeFileSync(editedConfig, 'model: edited\nmcp_servers: {caveman-codemode: {command: cm}, new: {command: new-mcp}}\n');
+  writeFileSync(join(outDir, "state.db"), "state");
+  syncBackHermesEphemeralHome(outDir, sourceHome);
+  assert.equal(readFileSync(sourceConfig, "utf8"), originalBlock);
+  assert.equal(readFileSync(join(sourceHome, "state.db"), "utf8"), "state");
+  assert.match(diagnostic.mock.calls.at(-1).arguments[0], /config\.yaml was not synced.*unsupported Hermes/);
+
+  writeFileSync(editedConfig, `${editedBlock}  new:\n    command: new-mcp\n`);
+  syncBackHermesEphemeralHome(outDir, sourceHome);
+  assert.equal(readFileSync(sourceConfig, "utf8"),
+    "model: edited\n\nmcp_servers:\n  docs:\n    command: docs-mcp\n  new:\n    command: new-mcp\n");
+
+  writeFileSync(sourceConfig, originalFlow);
+  assert.throws(build, /unsupported Hermes mcp_servers/);
+  assert.equal(readFileSync(sourceConfig, "utf8"), originalFlow);
+  assert.match(readFileSync(editedConfig, "utf8"), /^model: edited/);
+});
