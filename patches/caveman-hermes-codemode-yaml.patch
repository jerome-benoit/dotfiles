+function requireHermesCodemodeBlockRoot(yaml: string): void {
+  for (const line of yaml.split(/\r?\n/)) {
+    const content = stripYamlComment(line).trim();
+    if (!content || content === "---" || content.startsWith("%")) continue;
+    if (/^(?:---\s+)?[\[{]/.test(content)) {
+      throw new Error("unsupported Hermes config.yaml root; use a block mapping for Code Mode");
+    }
+    return;
+  }
+}
+
+function requireHermesCodemodeBlockMcp(value: string): void {
+  // The block reader has no server entries to restore from an inline value.
+  if (value && !/^(?:\{[ \t]*\}|null|Null|NULL|~)$/.test(value)) {
+    throw new Error("unsupported Hermes mcp_servers value in config.yaml; use a block mapping for Code Mode");
+  }
+}
