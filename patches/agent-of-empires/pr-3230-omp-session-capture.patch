+            .join(format!("aoe-pending_{id}.jsonl"));
+        let crumb = write_breadcrumb(&meta, "pts-1", &cwd, &pending, true);
+        let marker = tmp.path().join("launch-marker");
+        std::fs::write(
+            &marker,
