+                    "aoe-omp-test",
+                    meta.layout.terminal_sessions.to_str().unwrap(),
+                    marker.to_str().unwrap(),
+                    &meta.launch_id,
+                    meta.layout.sessions.to_str().unwrap(),
+                    meta.layout.managed_sessions.to_str().unwrap(),
+                    "managed",
