+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const managed = require('../../installer/lib/managed-plugins.js');
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const installer = path.join(repoRoot, 'installer/install.js');
+const sq = value => `'${value.replaceAll("'", "'\\''")}'`;
+const shell = process.env.CAVEMAN_TEST_SHELL || '/bin/sh';
+
+function fixture(t, profileName = 'profile with spaces') {
+  const dir = fs.mkdtempSync(path.join(fs.realpathSync(os.tmpdir()), 'caveman-nix-hooks-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const home = path.join(dir, 'home');
+  const profile = path.join(dir, profileName);
+  const log = path.join(dir, 'node-generations');
+  const emptyPath = path.join(dir, 'empty-path');
+  fs.mkdirSync(home);
+  fs.mkdirSync(emptyPath);
+  const bash = spawnSync(shell, ['--noprofile', '--norc', '-c', 'command -v bash'], { encoding: 'utf8' }).stdout.trim();
+  assert.ok(path.isAbsolute(bash), 'fixture requires Bash for the real statusline');
+  function generation(name) {
+    const generation = path.join(dir, name);
+    const node = path.join(generation, 'lib/caveman/node');
+    fs.mkdirSync(path.dirname(node), { recursive: true });
+    fs.writeFileSync(node, `#!${shell} --noprofile\nprintf '%s\\n' ${sq(name)} >> ${sq(log)}\nexec ${sq(process.execPath)} "$@"\n`, { mode: 0o755 });
+    fs.writeFileSync(path.join(path.dirname(node), 'bash'),
+      `#!${shell} --noprofile\nprintf '%s\\n' ${sq(name)} >> ${sq(log)}\nexport PATH=${sq(process.env.PATH)}\nexec ${sq(bash)} --noprofile --norc "$@"\n`, { mode: 0o755 });
+    return generation;
+  }
+  const a = generation('same-version-A');
+  const b = generation('same-version-B');
+  fs.symlinkSync(a, profile);
+  const env = {
+    HOME: home, USERPROFILE: home, PATH: emptyPath,
+    XDG_CONFIG_HOME: path.join(home, '.config'),
+    CAVEMAN_HOME: path.join(home, '.caveman'),
+    CAVEMAN_REGISTRATION_ROOT: profile, CAVEMAN_NIX_MANAGED: '1',
+    CLAUDE_CONFIG_DIR: path.join(home, '.claude'),
+    CODEX_HOME: path.join(home, 'custom-codex'),
+    COPILOT_HOME: path.join(home, 'custom-copilot'),
+    CAVEMAN_DEFAULT_MODE: 'caveman',
