+  fs.mkdirSync(f.env.CLAUDE_CONFIG_DIR, { recursive: true });
+  fs.writeFileSync(path.join(f.env.CLAUDE_CONFIG_DIR, 'settings.json'), JSON.stringify({ statusLine: statusline }));
