@@ -0,0 +1,208 @@
+'use strict';
+
+// A local, mutable bridge for hosts that load plugins outside the installer
+// wrapper. Only generated payloads are edited; host caches belong to the host.
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { createHash } = require('crypto');
+const SETTINGS = require('./settings');
+const OWNED = require('./owned-install');
+const { assertMutableParent } = OWNED;
+const { hookCommand } = require('./platform-paths');
+
+const MARKETPLACE = 'caveman-nix';
+const PLUGIN_ID = `caveman@${MARKETPLACE}`;
+
+function registrationRoot(env = process.env) {
+  const root = env.CAVEMAN_REGISTRATION_ROOT;
+  if (root === undefined) {
+    if (env.CAVEMAN_NIX_MANAGED === '1') {
+      throw new Error('Persistent registration requires CAVEMAN_REGISTRATION_ROOT: use a stable profile launcher or set an absolute stable profile prefix');
+    }
+    return null;
+  }
+  if (!root || !path.isAbsolute(root) || /[\x00-\x1f\x7f]/.test(root)) {
+    throw new Error('CAVEMAN_REGISTRATION_ROOT must be an absolute stable profile prefix');
+  }
+  const normalized = path.normalize(root);
+  if (normalized === '/nix/store' || normalized.startsWith('/nix/store/')) {
+    throw new Error('CAVEMAN_REGISTRATION_ROOT must not name a generation in /nix/store');
+  }
+  // Deliberately lexical. Resolving a profile symlink defeats the contract.
+  return normalized;
+}
+
+function defaultPluginDir(host) {
+  return path.join(process.env.CAVEMAN_HOME || path.join(os.homedir(), '.caveman'), `${host}-plugin`);
+}
+
+function automaticClaudePluginDir() {
+  // Match the ambient Claude CLI profile, not --config-dir's hook/settings root.
+  // Identity stays lexical; physical-ancestor checks still protect the payload.
+  const identity = path.resolve(SETTINGS.claudeConfigDir());
+  const profile = createHash('sha256').update(identity).digest('hex');
+  return path.join(path.dirname(defaultPluginDir('claude')), 'claude-profiles', profile, 'claude-plugin');
+}
+
+function pluginOperation({ host, repoRoot, node }) {
+  if (!['claude', 'cursor'].includes(host)) throw new Error('managed plugin host must be claude or cursor');
+  if (!repoRoot) throw new Error('managed plugin preparation requires the complete local source payload');
+  return (stage) => {
+    fs.mkdirSync(stage, { recursive: true, mode: 0o700 });
+    for (const relative of ['skills', 'agents', 'commands', 'src/hooks']) {
+      OWNED.copyPath(path.join(repoRoot, relative), path.join(stage, relative));
+    }
+    const command = (script, args = '') => `${hookCommand(node, [])} "\${${host === 'claude' ? 'CLAUDE' : 'CURSOR'}_PLUGIN_ROOT}/src/hooks/${script}"${args}`;
+    if (host === 'claude') {
+      // Claude mutates model frontmatter at SessionStart. Keep that policy
+      // upstream-owned, but account for its exact writes in our ownership journal.
+      const hooksDir = path.join(stage, 'src/hooks');
+      const profile = registrationRoot();
+      if (profile) {
+        fs.writeFileSync(path.join(hooksDir, 'caveman-statusline-runtime.json'),
+          JSON.stringify({ bashCommand: hookCommand(path.join(profile, 'lib/caveman/bash'), []) }) + '\n');
+      }
+      const modelHelper = path.join(hooksDir, 'cavecrew-model-overrides.js');
+      const upstreamModels = require(path.join(repoRoot, 'src/hooks/cavecrew-model-overrides.js'));
+      for (const { file } of upstreamModels.AGENT_ENV_MAP) fs.chmodSync(path.join(stage, file), 0o600);
+      fs.renameSync(modelHelper, path.join(hooksDir, 'cavecrew-model-overrides-upstream.js'));
+      OWNED.copyPath(path.join(__dirname, 'owned-install.js'), path.join(hooksDir, 'caveman-owned-install.js'));
+      fs.writeFileSync(modelHelper, `'use strict';
+const path = require('path');
+const upstream = require('./cavecrew-model-overrides-upstream');
+const OWNED = require('./caveman-owned-install');
+module.exports = {
+  ...upstream,
+  applyOverrides(pluginRoot, env) {
+    const root = path.resolve(__dirname, '../..');
+    if (path.resolve(pluginRoot) !== root) return;
+    const updates = new Map();
+    upstream.applyOverrides(root, env, (file, content) => {
+      updates.set(path.relative(root, file).split(path.sep).join('/'), content);
+    });
