+for (const failure of ['second replacement', 'journal commit']) {
+  test(`model update rolls back files and ownership after failed ${failure}`, { skip: process.platform === 'win32' }, t => {
+    const f = fixture(t);
+    const pluginDir = path.join(f.dir, 'claude-plugin');
+    const args = { host: 'claude', repoRoot, node: f.node, pluginDir };
+    fs.mkdirSync(pluginDir);
+    fs.writeFileSync(path.join(pluginDir, 'prior.txt'), 'prior user payload\n', { mode: 0o640 });
+    managed.preparePlugin({ ...args, force: true });
+    const owned = require('../../installer/lib/owned-install.js');
+    const journal = path.join(f.dir, '.caveman-claude-plugin-ownership.json');
+    const backup = path.join(f.dir, '.caveman-claude-plugin-backups',
+      JSON.parse(fs.readFileSync(journal)).entries['claude-plugin'].restoreBackup, 'prior.txt');
+    const reviewer = path.join(pluginDir, 'agents/cavecrew-reviewer.md');
+    const builder = path.join(pluginDir, 'agents/cavecrew-builder.md');
+    fs.chmodSync(builder, 0o640);
+    const files = [reviewer, builder, journal];
+    const originals = files.map(file => fs.readFileSync(file));
+    const modes = files.map(file => fs.statSync(file).mode & 0o777);
+    const update = {
+      root: f.dir, integration: 'claude-plugin', relativePath: 'claude-plugin',
+      updates: new Map([
+        ['agents/cavecrew-reviewer.md', originals[0].toString() + '\nreviewer override\n'],
+        ['agents/cavecrew-builder.md', originals[1].toString() + '\nbuilder override\n'],
+      ]),
+    };
+    const rename = fs.renameSync;
+    let injected = false;
+    fs.renameSync = (from, to) => {
+      const trigger = failure === 'journal commit' ? to === journal :
+        to === builder && path.basename(from).endsWith('.next');
+      if (!injected && trigger) {
+        assert.notDeepEqual(fs.readFileSync(reviewer), originals[0]);
+        injected = true;
+        throw Object.assign(new Error('injected filesystem failure'), { code: 'EIO' });
+      }
+      return rename(from, to);
+    };
+    try {
+      assert.throws(() => owned.updateOwnedFiles(update), /injected filesystem failure/);
+    } finally {
+      fs.renameSync = rename;
+    }
+    assert.ok(injected);
+    assert.deepEqual(files.map(file => fs.readFileSync(file)), originals);
+    assert.deepEqual(files.map(file => fs.statSync(file).mode & 0o777), modes);
+    assert.equal(fs.readFileSync(backup, 'utf8'), 'prior user payload\n');
+    assert.equal(fs.readdirSync(f.dir).some(name => name.startsWith('.caveman-model-update-')), false);
+    owned.updateOwnedFiles(update);
+    assert.match(fs.readFileSync(reviewer, 'utf8'), /reviewer override/);
+    assert.match(fs.readFileSync(builder, 'utf8'), /builder override/);
+    managed.removePlugin({ ...args, detached: true });
+    assert.equal(fs.readFileSync(path.join(pluginDir, 'prior.txt'), 'utf8'), 'prior user payload\n');
+    assert.equal(fs.statSync(path.join(pluginDir, 'prior.txt')).mode & 0o777, 0o640);
+    assert.equal(fs.existsSync(journal), false);
+  });
+}
