+test('automatic Claude profiles keep model payloads, ownership and callbacks isolated', { skip: process.platform === 'win32' }, t => {
+  const f = fixture(t);
+  const previous = new Map(Object.keys(f.env).map(key => [key, process.env[key]]));
+  Object.assign(process.env, f.env);
+  t.after(() => {
+    for (const [key, value] of previous) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+  });
+  function profile(name) {
+    const configDir = path.join(f.env.HOME, name);
+    const state = { marketplace: null, installed: false };
+    // Isolate only host control responses; payloads and callbacks stay real.
+    const capture = (_command, args) => ({
+      status: 0,
+      stdout: JSON.stringify(args[1] === 'marketplace'
+        ? state.marketplace ? [{ name: managed.MARKETPLACE, source: 'directory', path: state.marketplace }] : []
+        : state.installed ? [{ id: managed.PLUGIN_ID, scope: 'user', enabled: true }] : []),
+    });
+    const run = args => {
+      if (args[0] === 'marketplace' && args[1] === 'add') state.marketplace = args[2];
+      else if (args[0] === 'install') {
+        assert.equal(args[1], managed.PLUGIN_ID);
+        state.installed = true;
+      } else {
+        assert.deepEqual(args, ['marketplace', 'remove', managed.MARKETPLACE, '--scope', 'user']);
+        state.marketplace = null;
+        state.installed = false;
+      }
+      return true;
+    };
+    return { configDir, state, capture, run };
+  }
+  const a = profile('claude-A');
+  const b = profile('claude-B');
+  const install = selected => {
+    process.env.CLAUDE_CONFIG_DIR = selected.configDir;
+    return managed.installClaudePlugin({ ...selected, repoRoot, node: f.node, note() {} });
+  };
+  const journal = pluginDir => path.join(path.dirname(pluginDir), '.caveman-claude-plugin-ownership.json');
+  const agent = pluginDir => path.join(pluginDir, 'agents/cavecrew-reviewer.md');
+  const digest = pluginDir => JSON.parse(fs.readFileSync(journal(pluginDir)))
+    .entries[path.basename(pluginDir)].installedDigest;
+  const snapshot = pluginDir => ({
+    agent: fs.readFileSync(agent(pluginDir)),
+    journal: fs.readFileSync(journal(pluginDir)),
+  });
+  const command = pluginDir => JSON.parse(fs.readFileSync(path.join(pluginDir, '.claude-plugin/plugin.json')))
+    .hooks.SessionStart[0].hooks[0].command;
+  const callback = (selected, pluginDir, model) => {
+    const before = digest(pluginDir);
+    const output = f.runHook(command(pluginDir), {
+      session_id: `isolated-${model}`, source: 'startup', cwd: f.dir,
+    }, {
+      CLAUDE_CONFIG_DIR: selected.configDir, CLAUDE_PLUGIN_ROOT: pluginDir, CAVECREW_REVIEWER_MODEL: model,
+    });
+    assert.ok(output.length > 0);
+    assert.match(fs.readFileSync(agent(pluginDir), 'utf8'), new RegExp(`^model: ${model}$`, 'm'));
+    assert.notEqual(digest(pluginDir), before, 'actual model writes must advance ownership');
+  };
+  const aDir = install(a);
+  f.switchGeneration();
+  callback(a, aDir, 'sonnet');
+  const aBefore = snapshot(aDir);
+  const bDir = install(b);
+  // Assert consumer state first: the old shared destination resets A's model.
+  assert.deepEqual(snapshot(aDir), aBefore, 'installing B must not rewrite A payload or ownership');
+  assert.notEqual(bDir, aDir);
+  callback(b, bDir, 'opus');
+  const bBefore = snapshot(bDir);
+  const bRegistration = { ...b.state };
+  process.env.CLAUDE_CONFIG_DIR = a.configDir;
+  const removed = managed.removePlugin({ host: 'claude', pluginDir: aDir, capture: a.capture, run: a.run });
+  assert.deepEqual(removed.changed, []);
+  assert.equal(fs.existsSync(aDir), false);
+  assert.equal(fs.existsSync(journal(aDir)), false);
+  assert.equal(a.state.installed, false);
+  assert.deepEqual(b.state, bRegistration);
+  assert.deepEqual(snapshot(bDir), bBefore, 'removing A must not change B payload or ownership');
+  callback(b, bDir, 'sonnet');
+  assert.deepEqual(b.state, bRegistration);
+});
