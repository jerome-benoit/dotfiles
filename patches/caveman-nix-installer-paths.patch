+test('failed model rollback retains foreign edits and recoverable original bytes', { skip: process.platform === 'win32' }, t => {
+  const f = fixture(t);
+  const pluginDir = path.join(f.dir, 'claude-plugin');
+  managed.preparePlugin({ host: 'claude', repoRoot, node: f.node, pluginDir });
+  const owned = require('../../installer/lib/owned-install.js');
+  const reviewer = path.join(pluginDir, 'agents/cavecrew-reviewer.md');
+  const journal = path.join(f.dir, '.caveman-claude-plugin-ownership.json');
+  const original = fs.readFileSync(reviewer);
+  const originalJournal = fs.readFileSync(journal);
+  const rename = fs.renameSync;
+  let injected = false;
+  fs.renameSync = (from, to) => {
+    if (!injected && to === journal) {
+      injected = true;
+      fs.writeFileSync(reviewer, 'foreign runtime edit\n');
+      throw Object.assign(new Error('injected journal failure'), { code: 'EIO' });
+    }
+    return rename(from, to);
+  };
+  try {
+    assert.throws(() => owned.updateOwnedFiles({
+      root: f.dir, integration: 'claude-plugin', relativePath: 'claude-plugin',
+      updates: new Map([['agents/cavecrew-reviewer.md', original.toString() + '\nrequested model update\n']]),
+    }), /recovery retained/);
+  } finally {
+    fs.renameSync = rename;
+  }
+  assert.ok(injected);
+  assert.equal(fs.readFileSync(reviewer, 'utf8'), 'foreign runtime edit\n');
+  assert.deepEqual(fs.readFileSync(journal), originalJournal);
+  const recovery = fs.readdirSync(f.dir).find(name => name.startsWith('.caveman-model-update-'));
+  assert.ok(recovery);
+  assert.ok(fs.readdirSync(path.join(f.dir, recovery)).some(name =>
+    fs.readFileSync(path.join(f.dir, recovery, name)).equals(original)), 'original model bytes must remain recoverable');
+});
