+def _copy_snapshot_tree(source: Path, target: Path, ignore) -> None:
+    # copytree flattens child errors to strings, and copyfile can conflate source
+    # reads and destination writes. Keep those operations separate.
+    buffer = memoryview(bytearray(shutil.COPY_BUFSIZE))
+
+    def copy_entry(src: Path, dst: Path, info: os.stat_result) -> None:
+        if stat.S_ISDIR(info.st_mode):
+            with os.scandir(src) as entries:
+                children = list(entries)
+            excluded = ignore(os.fspath(src), [entry.name for entry in children])
+            _destination_call(dst.mkdir)
+            for entry in children:
+                if entry.name not in excluded:
+                    copy_entry(Path(entry.path), dst / entry.name, entry.stat())
+        elif stat.S_ISREG(info.st_mode):
+            with src.open("rb", buffering=0) as reader:
+                writer = _destination_call(dst.open, "wb")
+                try:
+                    while count := reader.readinto(buffer):
+                        _destination_call(writer.write, buffer[:count])
+                    _destination_call(writer.close)
